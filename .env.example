# qwen-web-arwaky — environment variable contract
#
# This is the single source of truth for every variable the application
# recognizes (see modules/shared/src/utility_core_env.py). Copy it to `.env`
# (never commit the filled-in copy) and review each value.
#
# Sensitivity: [secret] values carry credentials and must never be printed,
# logged, or committed. [behavior] switches change runtime behaviour; a typo
# silently degrades to the default. `qwen-web-arwaky doctor --json` echoes the
# effective (masked) configuration and warns on unrecognized QWEN_* / QWA_*
# variables.

# ── Deployment mode ───────────────────────────────────────────────────────────
# "production" renders structured JSON logs; "development" (or a TTY) renders
# colored console logs. On a production host, error tracking must be
# provisioned or doctor reports a WARNING (issue #297).
ENVIRONMENT=production

# ── Error tracking (Sentry) ───────────────────────────────────────────────────
# [secret] Project DSN. Empty = error tracking off; in production that is a
# WARNING shown by doctor (issue #297).
SENTRY_DSN=

# ── Distributed tracing (OpenTelemetry) ──────────────────────────────────────
# Empty endpoint = tracing collects spans in-process only (no export).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=qwen-web

# ── Browser runtime ──────────────────────────────────────────────────────────
# Override the Playwright browser cache directory (platform default otherwise).
PLAYWRIGHT_BROWSERS_PATH=
# Opt out of Chromium's OS sandbox only where it cannot start without it
# (unprivileged containers). Sandboxed by default since v6.5.0 (issue #290).
QWEN_DISABLE_SANDBOX=0
QWEN_ENABLE_SANDBOX=

# ── Parallelism (issue #291) ──────────────────────────────────────────────────
# When unset, the worker count is derived from host memory (~700 MiB per
# Chromium worker, clamped to the cap below). Set explicitly to override.
QWEN_WEB_MAX_WORKERS=
QWEN_SWARM_CONCURRENCY=
# "0" or "false" forces Swarm browsers headed (default: headless).
QWA_SWARM_HEADLESS=

# ── Delivery / updates ────────────────────────────────────────────────────────
# GitHub owner/repo for update discovery. Updates pin the release to an
# immutable commit SHA; an unpinnable target refuses the install.
QWEN_WEB_GITHUB_REPO=rakaarwaky/qwen-web-arwaky

# ── Prompt / model behaviour ──────────────────────────────────────────────────
# Model pinned at chat start; empty falls back to Qwen3.8-Max.
QWEN_DEFAULT_MODEL=
# Safety timeout for a streaming response in seconds; 0 disables the guard.
QWEN_STREAM_SAFETY_TIMEOUT_SEC=

# ── Diagnostics / local development ───────────────────────────────────────────
# "1" enables the slow Playwright cold-start probe in doctor (5-15 s).
QWEN_DOCTOR_DEEP=0
# "1" prints the effective Chromium binary path in doctor output.
QWEN_DOCTOR_SHOW_PATH=0

# ── MCP file boundary ─────────────────────────────────────────────────────────
# Root path that bounds MCP upload/download access. Must be absolute when set;
# unset = current directory.
QWEN_WORKSPACE_ROOT=
